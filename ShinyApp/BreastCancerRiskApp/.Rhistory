#| message: false
#| warning: false
dir.create("models/multiclass", recursive=TRUE, showWarnings=FALSE)
# ── 1. Full training data: batch-correct + gene selection ────────────────────
# All labeled samples across all 3 datasets
ok_all   <- !is.na(p_merged_mc$label_mc) & p_merged_mc$label_mc != ""
y_all    <- factor(p_merged_mc$label_mc[ok_all])
e_all    <- e_merged_mc[, ok_all, drop=FALSE]
batch_all <- p_merged_mc$dataset_id[ok_all]
mod_all <- model.matrix(~ y_all)
# Batch-correct full training set. Store the raw batch parameters manually
# so we can apply them to future new samples.
grand_mean_all  <- rowMeans(e_all)
batch_train_f   <- factor(as.character(batch_all))
batch_means_all <- sapply(levels(batch_train_f), function(b) {
idx <- which(batch_train_f == b)
rowMeans(e_all[, idx, drop=FALSE])
})
e_all_bc <- tryCatch(
sva::ComBat(dat=e_all, batch=batch_all, mod=mod_all,
par.prior=TRUE, mean.only=FALSE),
error = function(e) {
message("ComBat failed, using removeBatchEffect: ", conditionMessage(e))
limma::removeBatchEffect(e_all, batch=batch_all, design=mod_all)
}
)
# ── 2. OvR gene selection on full batch-corrected training set ───────────────
panel_genes <- select_genes_ovr(e_all_bc, y=y_all, n_per_class=50)
cat("Final multiclass panel genes:", length(panel_genes), "\n")
# ── 3. Preprocessing stats (imputation + z-score) from full training set ─────
X_all_bc  <- t(e_all_bc[panel_genes, , drop=FALSE])
imp_final <- impute_fit(X_all_bc)
X_all_i   <- impute_apply(X_all_bc, imp_final)
sc_final  <- std_fit(X_all_i)
X_all_s   <- std_apply(X_all_i, sc_final)
# ── 4. Fit final models (same set as LODO) ───────────────────────────────────
lvls_all  <- levels(y_all)
n_cl_all  <- length(lvls_all)
tab_all   <- table(y_all); n_tot_all <- sum(tab_all)
cw_all    <- setNames(vapply(lvls_all, function(k)
n_tot_all / (n_cl_all * max(1, tab_all[k])), numeric(1)), lvls_all)
sw_all    <- cw_all[as.character(y_all)]
# kNN (stored as training data + labels — kNN has no compact fit object)
fit_knn_final <- list(X_train = X_all_s, y_train = y_all, k = 7)
# RF
fit_rf_final <- randomForest::randomForest(X_all_i, y_all, classwt=cw_all)
# Multinomial Lasso
fit_lasso_final <- glmnet::cv.glmnet(
as.matrix(X_all_s), y_all, family="multinomial",
alpha=1, weights=sw_all, standardize=FALSE, type.multinomial="grouped"
)
# Multinom (nnet)
fit_multinom_final <- if (requireNamespace("nnet", quietly=TRUE)) {
tryCatch(
nnet::multinom(y_all~., data=data.frame(y_all, X_all_s),
weights=sw_all, trace=FALSE, MaxNWts=100000),
error=function(e) { message("nnet failed: ", conditionMessage(e)); NULL }
)
} else NULL
# ── 5. Save everything ────────────────────────────────────────────────────────
saveRDS(panel_genes,    "models/multiclass/panel_genes.rds")
saveRDS(list(
grand_mean   = grand_mean_all,
batch_means  = batch_means_all,
datasets_seen = levels(batch_train_f)
), "models/multiclass/batch_correction_params.rds")
saveRDS(imp_final,      "models/multiclass/imputation_params.rds")
saveRDS(sc_final,       "models/multiclass/scale_params.rds")
saveRDS(fit_knn_final,  "models/multiclass/fit_knn.rds")
saveRDS(fit_rf_final,   "models/multiclass/fit_rf.rds")
saveRDS(fit_lasso_final,"models/multiclass/fit_lasso.rds")
if (!is.null(fit_multinom_final))
saveRDS(fit_multinom_final, "models/multiclass/fit_multinom.rds")
cat("\nSaved to models/multiclass/:\n")
cat(paste(" -", list.files("models/multiclass"), collapse="\n"), "\n")
# ── Save uncertainty outputs ──────────────────────────────────────────────────
if (exists("boot_risk_mc") && !is.null(boot_risk_mc)) {
saveRDS(boot_risk_mc, "models/multiclass/bootstrap_risk_scores.rds")
cat("Saved bootstrap risk scores:", nrow(boot_risk_mc), "patients\n")
}
if (exists("uncertainty_df") && !is.null(uncertainty_df)) {
saveRDS(uncertainty_df, "models/multiclass/model_disagreement.rds")
cat("Saved model disagreement metrics\n")
}
#| message: false
#| warning: false
# ── Load all saved components ─────────────────────────────────────────────────
predict_pam50_subtype <- function(expr_new,
model_dir  = "models/multiclass",
model_name = "RF",
new_dataset = NULL) {
# expr_new : genes × samples matrix (raw, quantile-normalised per dataset)
# model_name: one of "RF", "LassoMC", "Multinom", "kNN"
# new_dataset: optional string — dataset name if known, NULL for novel data
panel_genes  <- readRDS(file.path(model_dir, "panel_genes.rds"))
bc_params    <- readRDS(file.path(model_dir, "batch_correction_params.rds"))
imp_params   <- readRDS(file.path(model_dir, "imputation_params.rds"))
sc_params    <- readRDS(file.path(model_dir, "scale_params.rds"))
# ── Step 1: apply batch correction ───────────────────────────────────────────
genes_common <- intersect(panel_genes, rownames(expr_new))
if (length(genes_common) < 10)
stop("Too few panel genes found in new data (",
length(genes_common), "/", length(panel_genes), ")")
e_new <- expr_new[genes_common, , drop=FALSE]
if (!is.null(new_dataset) &&
new_dataset %in% bc_params$datasets_seen) {
# Known dataset: subtract the learned batch offset
batch_offset <- bc_params$batch_means[genes_common, new_dataset] -
bc_params$grand_mean[genes_common]
e_new_bc <- sweep(e_new, 1, batch_offset, "-")
message("Applied batch offset for known dataset: ", new_dataset)
} else {
# Novel dataset: mean-centre each sample to the training grand mean
sample_means  <- colMeans(e_new)
grand_mean_sub <- bc_params$grand_mean[genes_common]
e_new_bc <- sweep(e_new, 2, sample_means, "-") +
rowMeans(matrix(grand_mean_sub, ncol=1))
message("Novel dataset — applied mean-centring only")
}
# ── Step 2: impute + scale using training statistics ─────────────────────────
# Subset imp and scale params to genes present
imp_sub <- list(med = imp_params$med[genes_common])
sc_sub  <- list(mu  = sc_params$mu[genes_common],
sd  = sc_params$sd[genes_common])
X_new   <- t(e_new_bc)
X_new_i <- impute_apply(X_new, imp_sub)
X_new_s <- std_apply(X_new_i, sc_sub)
# ── Step 3: predict ───────────────────────────────────────────────────────────
prob_mat <- if (model_name == "RF") {
fit <- readRDS(file.path(model_dir, "fit_rf.rds"))
predict(fit, X_new_i, type="prob")
} else if (model_name == "LassoMC") {
fit <- readRDS(file.path(model_dir, "fit_lasso.rds"))
pr  <- predict(fit, as.matrix(X_new_s), type="response",
s="lambda.min")[,,1]
if (is.null(dim(pr))) t(as.matrix(pr)) else pr
} else if (model_name == "Multinom") {
mpath <- file.path(model_dir, "fit_multinom.rds")
if (!file.exists(mpath)) stop("fit_multinom.rds not found")
fit <- readRDS(mpath)
pm  <- predict(fit, newdata=data.frame(X_new_s), type="probs")
if (is.null(dim(pm))) t(as.matrix(pm)) else pm
} else if (model_name == "kNN") {
fit      <- readRDS(file.path(model_dir, "fit_knn.rds"))
pred_knn <- class::knn(train=fit$X_train[, genes_common, drop=FALSE],
test=X_new_s,
cl=fit$y_train, k=fit$k, prob=TRUE)
kw  <- attr(pred_knn, "prob")
pkc <- as.character(pred_knn)
lvls <- levels(fit$y_train)
pm  <- matrix(0, nrow(X_new_s), length(lvls), dimnames=list(NULL, lvls))
for (i in seq_len(nrow(pm))) {
pm[i, pkc[i]] <- kw[i]
oth <- setdiff(lvls, pkc[i])
if (length(oth)) pm[i, oth] <- (1 - kw[i]) / length(oth)
}
pm
} else {
stop("Unknown model_name: ", model_name,
". Choose from: RF, LassoMC, Multinom, kNN")
}
# ── Step 4: format output ─────────────────────────────────────────────────────
pred_subtype <- colnames(prob_mat)[max.col(prob_mat)]
confidence   <- apply(prob_mat, 1, max)
result <- as.data.frame(round(prob_mat, 3))
result$predicted_subtype <- pred_subtype
result$confidence        <- round(confidence, 3)
result$model             <- model_name
result$genes_used        <- length(genes_common)
result$genes_missing     <- length(panel_genes) - length(genes_common)
result
}
# ── Quick sanity check on hold-out set ───────────────────────────────────────
if (exists("X_mc_hold") && nrow(X_mc_hold) > 0) {
# Reconstruct a genes × samples matrix from hold-out
e_hold_raw <- t(X_mc_hold)  # back to genes × samples
test_result <- tryCatch(
predict_pam50_subtype(e_hold_raw, model_name="RF", new_dataset=NULL),
error = function(e) { message("Prediction test failed: ", conditionMessage(e)); NULL }
)
if (!is.null(test_result)) {
test_result$true_subtype <- as.character(y_mc_hold)
test_result$correct      <- test_result$predicted_subtype == test_result$true_subtype
cat(sprintf("Sanity check — hold-out accuracy (RF): %.1f%%\n",
100 * mean(test_result$correct, na.rm=TRUE)))
knitr::kable(
head(test_result %>%
arrange(desc(confidence)) %>%
select(predicted_subtype, true_subtype, correct,
confidence, genes_used, genes_missing), 10),
caption="predict_pam50_subtype() — top 10 most confident hold-out predictions"
)
}
}
